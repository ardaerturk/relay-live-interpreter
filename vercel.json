{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":"vite","buildCommand":"npm run build","outputDirectory":"dist","regions":["fra1"],
  "functions":{"api/*.js":{"maxDuration":40}},
  "headers":[{"source":"/(.*)","headers":[
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"X-Robots-Tag","value":"noindex, nofollow"},
    {"key":"X-Frame-Options","value":"DENY"},
    {"key":"Permissions-Policy","value":"microphone=(self), camera=(), geolocation=(), screen-wake-lock=(self)"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; media-src 'self' blob:; worker-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"}
  ]}]
}
